rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Drivers collection — authenticated user can read and write their own driver profile
    match /drivers/{driverId} {
      allow read, write: if request.auth != null && request.auth.uid == driverId;
    }

    // Vehicles collection — readable by all authenticated transit personnel & drivers
    match /vehicles/{vehicleId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Depots collection — readable by all authenticated transit personnel
    match /depots/{depotId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Transit routes & stops — readable by all authenticated drivers
    match /routes/{routeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Trips — readable and updatable by authenticated drivers
    match /trips/{tripId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Assignments — readable by authenticated drivers
    match /assignments/{assignmentId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Notifications — readable and updatable by authenticated drivers
    match /notifications/{notifId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
